diff --git a/tpm.c b/tpm.c
new file mode 100644
index 0000000..5630a6f
--- /dev/null
+++ b/tpm.c
@@ -0,0 +1,321 @@
+/*
+ * Measured boot for a TPM 2.0 behind QEMU's tpm-crb.
+ *
+ * The host names what this boot measures in opt/org.spin-stack/tpm-events: a
+ * space-separated list of events, each four hex tokens, its PCR, its event
+ * type, the SHA-256 of what was measured and the event's data.  qboot starts
+ * the TPM, extends each event into every active PCR bank, and writes the
+ * TCG2 crypto-agile log to the area QEMU's TPM2 table points at (etc/tpm/log),
+ * where Linux finds it.  The host hashes, because qboot cannot see the
+ * vmlinux QEMU loaded for PVH, and hashing a large initrd here would be on
+ * every boot's clock.
+ *
+ * A bank of another algorithm is extended with the SHA-256 digest cut or
+ * zero-padded to its size, as SeaBIOS did before it hashed per bank: no bank
+ * is left for the guest to fill with a log of its own, and only the SHA-256
+ * bank's digests are the digests of what was measured.
+ *
+ * A TPM that fails a command ends the measuring and the boot goes on: what
+ * was measured until then is in the PCRs and the log alike.
+ */
+#include "bios.h"
+#include "string.h"
+#include "fw_cfg.h"
+#include "bswap.h"
+
+#define CRB_BASE	0xfed40000
+#define CRB_LOC_CTRL	0x08
+#define CRB_CTRL_REQ	0x40
+#define CRB_CTRL_STS	0x44
+#define CRB_CTRL_START	0x4c
+#define CRB_CTRL_CMD_SIZE 0x58
+#define CRB_DATA	0x80
+
+#define EV_NO_ACTION	3
+#define TPM_ALG_SHA256	0x000b
+#define SHA256_SIZE	32
+#define MAX_BANKS	8
+
+static uint8_t *log, *log_end;
+static int nbanks;
+static struct { uint16_t alg, size; } banks[MAX_BANKS];
+
+static inline volatile uint32_t *crb(int reg)
+{
+	return (volatile uint32_t *)(CRB_BASE + reg);
+}
+
+/* A register that does not clear in about a minute of reads is a TPM gone. */
+static bool crb_wait_clear(int reg, uint32_t bit)
+{
+	uint32_t n;
+
+	for (n = 0; n < (1u << 26); n++)
+		if (!(*crb(reg) & bit))
+			return true;
+	return false;
+}
+
+static void put_be16(uint8_t *p, uint16_t v) { v = bswap16(v); memcpy(p, &v, 2); }
+static void put_be32(uint8_t *p, uint32_t v) { v = bswap32(v); memcpy(p, &v, 4); }
+static uint16_t get_be16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return bswap16(v); }
+
+/* Sends the command in buf, whose header's size is filled here, and leaves the
+ * response in buf.  Returns the response code, or -1 for a TPM that did not answer.  */
+static int tpm_transact(uint8_t *buf, uint32_t len)
+{
+	volatile uint8_t *data = (volatile uint8_t *)(CRB_BASE + CRB_DATA);
+	uint32_t i, n;
+
+	put_be32(buf + 2, len);
+	if (len > *crb(CRB_CTRL_CMD_SIZE))
+		return -1;
+	*crb(CRB_CTRL_REQ) = 1;			/* cmdReady */
+	if (!crb_wait_clear(CRB_CTRL_REQ, 1))
+		return -1;
+	for (i = 0; i < len; i++)
+		data[i] = buf[i];
+	*crb(CRB_CTRL_START) = 1;
+	if (!crb_wait_clear(CRB_CTRL_START, 1) || (*crb(CRB_CTRL_STS) & 1))
+		return -1;
+	n = ldl_be_p((const void *)(data + 2));
+	if (n < 10 || n > 1024)
+		return -1;
+	for (i = 0; i < n; i++)
+		buf[i] = data[i];
+	return ldl_be_p(buf + 6);
+}
+
+static bool tpm_startup(void)
+{
+	uint8_t buf[1024];
+	int rc;
+
+	put_be16(buf, 0x8001);
+	put_be32(buf + 6, 0x144);		/* TPM2_Startup */
+	put_be16(buf + 10, 0);			/* TPM_SU_CLEAR */
+	rc = tpm_transact(buf, 12);
+	return rc == 0 || rc == 0x100;		/* TPM_RC_INITIALIZE: started already */
+}
+
+static uint16_t digest_size(uint16_t alg)
+{
+	switch (alg) {
+	case 0x0004: return 20;			/* SHA-1 */
+	case 0x000b: return 32;			/* SHA-256 */
+	case 0x000c: return 48;			/* SHA-384 */
+	case 0x000d: return 64;			/* SHA-512 */
+	case 0x0012: return 32;			/* SM3-256 */
+	}
+	return 0;
+}
+
+/* The banks with a PCR selected, from TPM2_GetCapability(TPM_CAP_PCRS).  */
+static bool tpm_banks(void)
+{
+	uint8_t buf[1024], *p;
+	uint32_t i, j, count;
+	bool active;
+
+	put_be16(buf, 0x8001);
+	put_be32(buf + 6, 0x17a);		/* TPM2_GetCapability */
+	put_be32(buf + 10, 5);			/* TPM_CAP_PCRS */
+	put_be32(buf + 14, 0);
+	put_be32(buf + 18, 1);
+	if (tpm_transact(buf, 22) != 0)
+		return false;
+	count = ldl_be_p(buf + 15);
+	p = buf + 19;
+	for (i = 0; i < count; i++) {
+		uint16_t alg = get_be16(p);
+		uint8_t n = p[2];
+
+		if (p + 3 + n > buf + 1024)
+			return false;
+		active = false;
+		for (j = 0; j < n; j++)
+			active |= p[3 + j] != 0;
+		p += 3 + n;
+		if (!active)
+			continue;
+		if (!digest_size(alg) || nbanks == MAX_BANKS)
+			return false;
+		banks[nbanks].alg = alg;
+		banks[nbanks].size = digest_size(alg);
+		nbanks++;
+	}
+	return nbanks > 0;
+}
+
+/* The digest a bank is extended with: the SHA-256 digest, cut or zero-padded.  */
+static uint8_t *put_digest(uint8_t *p, int bank, const uint8_t *sha256)
+{
+	uint16_t n = banks[bank].size;
+
+	memset(p, 0, n);
+	memcpy(p, sha256, n < SHA256_SIZE ? n : SHA256_SIZE);
+	return p + n;
+}
+
+static bool tpm_extend(uint32_t pcr, const uint8_t *sha256)
+{
+	uint8_t buf[1024], *p;
+	int i;
+
+	put_be16(buf, 0x8002);
+	put_be32(buf + 6, 0x182);		/* TPM2_PCR_Extend */
+	put_be32(buf + 10, pcr);
+	put_be32(buf + 14, 9);			/* the password session's size */
+	put_be32(buf + 18, 0x40000009);		/* TPM_RS_PW, empty */
+	memset(buf + 22, 0, 5);
+	put_be32(buf + 27, nbanks);
+	p = buf + 31;
+	for (i = 0; i < nbanks; i++) {
+		put_be16(p, banks[i].alg);
+		p = put_digest(p + 2, i, sha256);
+	}
+	return tpm_transact(buf, p - buf) == 0;
+}
+
+static uint8_t *log_put32(uint8_t *p, uint32_t v)
+{
+	memcpy(p, &v, 4);
+	return p + 4;
+}
+
+/* The log's first event, which says it is crypto-agile and which banks its events carry.  */
+static bool log_spec_id(void)
+{
+	static const char sig[16] = "Spec ID Event03";
+	uint32_t size = 16 + 4 + 4 + 4 + 4 * nbanks + 1;
+	uint8_t *p = log;
+	int i;
+
+	if (32 + size > log_end - log)
+		return false;
+	p = log_put32(p, 0);			/* PCR 0 */
+	p = log_put32(p, EV_NO_ACTION);
+	memset(p, 0, 20);
+	p = log_put32(p + 20, size);
+	memcpy(p, sig, 16);
+	p = log_put32(p + 16, 0);		/* platform class: client */
+	*p++ = 0;				/* spec 2.0, errata 2 */
+	*p++ = 2;
+	*p++ = 2;
+	*p++ = 2;				/* UINTN is 64 bits */
+	p = log_put32(p, nbanks);
+	for (i = 0; i < nbanks; i++) {
+		memcpy(p, &banks[i].alg, 2);
+		memcpy(p + 2, &banks[i].size, 2);
+		p += 4;
+	}
+	*p++ = 0;				/* no vendor info */
+	log = p;
+	return true;
+}
+
+static bool log_has_room(uint32_t size)
+{
+	uint32_t need = 12 + 4 + size;
+	int i;
+
+	for (i = 0; i < nbanks; i++)
+		need += 2 + banks[i].size;
+	return need <= log_end - log;
+}
+
+static void log_event(uint32_t pcr, uint32_t type, const uint8_t *sha256,
+		      const uint8_t *data, uint32_t size)
+{
+	uint8_t *p = log;
+	int i;
+
+	p = log_put32(p, pcr);
+	p = log_put32(p, type);
+	p = log_put32(p, nbanks);
+	for (i = 0; i < nbanks; i++) {
+		memcpy(p, &banks[i].alg, 2);
+		p = put_digest(p + 2, i, sha256);
+	}
+	p = log_put32(p, size);
+	memcpy(p, data, size);
+	log = p + size;
+}
+
+static int hexval(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	return -1;
+}
+
+/* The next token of s as bytes into out, at most max of them; its length, or -1.  */
+static int hex_bytes(char **s, uint8_t *out, int max)
+{
+	char *p = *s;
+	int n = 0, hi, lo;
+
+	while (*p && *p != ' ') {
+		hi = hexval(p[0]);
+		lo = hi < 0 ? -1 : hexval(p[1]);
+		if (lo < 0 || n == max)
+			return -1;
+		out[n++] = hi << 4 | lo;
+		p += 2;
+	}
+	if (*p == ' ')
+		p++;
+	*s = p;
+	return n;
+}
+
+/* The next token of s as a number of at most 32 bits, written big-endian.  */
+static bool hex_u32(char **s, uint32_t *v)
+{
+	uint8_t b[4];
+	int n = hex_bytes(s, b, 4), i;
+
+	if (n <= 0)
+		return false;
+	*v = 0;
+	for (i = 0; i < n; i++)
+		*v = *v << 8 | b[i];
+	return true;
+}
+
+void tpm_measure_boot(void)
+{
+	int id = fw_cfg_file_id("opt/org.spin-stack/tpm-events");
+	uint32_t n, pcr, type;
+	uint8_t sha256[SHA256_SIZE], data[256];
+	char *events, *s;
+	int size;
+
+	if (id == -1)
+		return;
+	log = acpi_file_addr("etc/tpm/log");
+	if (!log)
+		return;
+	log_end = log + fw_cfg_file_size(fw_cfg_file_id("etc/tpm/log"));
+	n = fw_cfg_file_size(id);
+	events = malloc(n + 1);
+	fw_cfg_read_file(id, events, n);
+	events[n] = 0;
+
+	*crb(CRB_LOC_CTRL) = 1;			/* locality 0: requestAccess */
+	if (!tpm_startup() || !tpm_banks() || !log_spec_id())
+		goto out;
+	for (s = events; *s;) {
+		if (!hex_u32(&s, &pcr) || !hex_u32(&s, &type) ||
+		    hex_bytes(&s, sha256, SHA256_SIZE) != SHA256_SIZE)
+			break;
+		size = hex_bytes(&s, data, sizeof(data));
+		if (size < 0 || !log_has_room(size) || !tpm_extend(pcr, sha256))
+			break;
+		log_event(pcr, type, sha256, data, size);
+	}
+out:
+	*crb(CRB_LOC_CTRL) = 2;			/* relinquish */
+}
