From: Manuel de Brito Fontes <aledbf@gmail.com>
Date: Mon, 23 Nov 2026 00:00:00 -0300
Subject: [PATCH] hw/i386: map a bzImage loaded by -kernel instead of reading
 it

x86_load_linux reads the whole kernel into a heap buffer that only
fw_cfg ever reads: FW_CFG_KERNEL_DATA and etc/boot/kernel point into it,
and the setup header it patches is a copy of its own.  For a 16.7 MB
bzImage that read is 6.2-6.9 ms of QEMU's start, traced, and the
firmware then copies the same bytes again by fw_cfg DMA.

Map the file read-only instead, as commit e502fe96ac43 ("hw/i386/pc: Map
into memory the initrd", 2019) did for the initrd and the same series
did for an ELF kernel.  The pages are touched only when the firmware
copies them into the guest, from the page cache, and QEMU no longer
holds a private anonymous copy of the kernel.  A kernel with a dtb
appended still gets a buffer, which it grows.

A file truncated in place while QEMU runs now faults QEMU instead of
leaving it a stale copy; a release's kernel is replaced by rename,
which leaves the mapping on the old inode.
---
--- a/hw/i386/x86-common.c
+++ b/hw/i386/x86-common.c
@@ -913,16 +913,41 @@
     }
 
     setup  = g_malloc(setup_size);
-    kernel = g_malloc(kernel_size);
     fseek(f, 0, SEEK_SET);
     if (fread(setup, 1, setup_size, f) != setup_size) {
         fprintf(stderr, "fread() failed\n");
         exit(1);
     }
-    fseek(f, 0, SEEK_SET);
-    if (fread(kernel, 1, kernel_size, f) != kernel_size) {
-        fprintf(stderr, "fread() failed\n");
-        exit(1);
+    if (dtb_filename) {
+        /* the dtb is appended to the kernel, which needs a buffer of its own */
+        kernel = g_malloc(kernel_size);
+        fseek(f, 0, SEEK_SET);
+        if (fread(kernel, 1, kernel_size, f) != kernel_size) {
+            fprintf(stderr, "fread() failed\n");
+            exit(1);
+        }
+    } else {
+        /*
+         * Map the kernel rather than read it: nothing writes to it, and
+         * fw_cfg is its only reader, so its pages are touched only when the
+         * firmware copies them into the guest.  The mapping is never
+         * unmapped, as the buffer was never freed.
+         */
+        GMappedFile *mapped_file;
+        GError *gerr = NULL;
+
+        mapped_file = g_mapped_file_new_from_fd(fileno(f), false, &gerr);
+        if (!mapped_file) {
+            fprintf(stderr, "qemu: could not map kernel '%s': %s\n",
+                    kernel_filename, gerr->message);
+            exit(1);
+        }
+        if (g_mapped_file_get_length(mapped_file) != (gsize)kernel_size) {
+            fprintf(stderr, "qemu: kernel '%s' changed while it was loaded\n",
+                    kernel_filename);
+            exit(1);
+        }
+        kernel = (uint8_t *)g_mapped_file_get_contents(mapped_file);
     }
     fclose(f);
 
