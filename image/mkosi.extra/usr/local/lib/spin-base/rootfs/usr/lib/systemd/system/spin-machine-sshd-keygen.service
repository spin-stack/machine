# docs/image.md, "The host keys"
[Unit]
Description=Generate SSH host keys for this VM
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Before=ssh.service sshd.service
ConditionPathExists=/usr/bin/ssh-keygen

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'f=/etc/ssh/ssh_host_ed25519_key; [ -e "$$f" ] || exec /usr/bin/ssh-keygen -q -t ed25519 -N "" -f "$$f"'

[Install]
WantedBy=sysinit.target
