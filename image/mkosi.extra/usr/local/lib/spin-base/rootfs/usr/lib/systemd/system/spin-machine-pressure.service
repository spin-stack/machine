# docs/image.md, "The pressure sender"
[Unit]
Description=Report the guest's pressure to the host
ConditionPathExists=/proc/pressure/cpu

[Service]
ExecStart=/usr/libexec/spin-machine-pressure
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
