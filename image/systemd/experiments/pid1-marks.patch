diff -ruN a/src/core/spin-mark.h b/src/core/spin-mark.h
--- a/src/core/spin-mark.h	1969-12-31 21:00:00.000000000 -0300
+++ b/src/core/spin-mark.h	2026-11-19 13:01:04.896028361 -0300
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+/* spin-machine experiment: PID 1's steps between the unit load and the first job, appended to
+ * /run/spin-pid1-marks as "<CLOCK_MONOTONIC usec> <its own CPU usec> <units loaded> <usec in
+ * unit_load> <step>", which boot:waits reads after the boot. Wall time far above CPU time is PID 1
+ * waiting - on the disk or for a CPU - rather than parsing. A file and not /dev/kmsg, whose user
+ * writes the kernel rate-limits. Not for a release. */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+extern unsigned spin_units_loaded;
+extern unsigned long long spin_unit_load_usec;
+
+static inline unsigned long long spin_usec(clockid_t clock) {
+        struct timespec ts;
+        (void) clock_gettime(clock, &ts);
+        return (unsigned long long) ts.tv_sec * 1000000ULL + (unsigned long long) ts.tv_nsec / 1000ULL;
+}
+
+static inline void spin_mark(const char *what) {
+        int fd;
+
+        if (getpid() != 1)
+                return;
+        fd = open("/run/spin-pid1-marks", O_WRONLY|O_CREAT|O_APPEND|O_CLOEXEC|O_NOCTTY, 0644);
+        if (fd < 0)
+                return;
+        (void) dprintf(fd, "%llu %llu %u %llu %s\n", spin_usec(CLOCK_MONOTONIC), spin_usec(CLOCK_THREAD_CPUTIME_ID),
+                       spin_units_loaded, spin_unit_load_usec, what);
+        (void) close(fd);
+}
