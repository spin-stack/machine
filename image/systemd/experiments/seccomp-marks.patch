+/* #637's instrument: the thread CPU each sandbox step takes in the executor, logged once a step ran. */
+static usec_t spin_cpu_now(void) {
+        struct timespec ts;
+        assert_se(clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0);
+        return timespec_load(&ts);
+}
+#define SPIN_MARK(name, expr) ({                                                \
+                usec_t _t0 = spin_cpu_now();                                    \
+                int _r = (expr);                                                \
+                log_info("spin-seccomp-mark %s %s %" PRIu64 "us r=%i",          \
+                         params->unit_id ?: "?", name, spin_cpu_now() - _t0, _r); \
+                _r;                                                             \
+        })
