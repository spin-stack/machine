From: Hou Wenlong <houwenlong.hwl@antgroup.com>
Date: Mon, 26 Jan 2026 21:33:53 +0800
Subject: [PATCH] x86: Allow to build relocatable uncompressed kernel binary

Add support for building a relocatable uncompressed kernel binary, which
contains the relocation table generated by the 'relocs' tool and can be
used to perform KASLR directly when booting from it instead of a
compressed kernel image. To simplify, follow the MIPS implementation to
reserve a section to store the relocation table.

Signed-off-by: Hou Wenlong <houwenlong.hwl@antgroup.com>
[ spin-stack/machine: forward-ported to 7.3.5 for #645, and made
  checkpatch --strict clean: a four-line help for
  RELOCATABLE_UNCOMPRESSED_KERNEL, and the postlink targets in another
  order, which checkpatch read as a repeated word. ]
Assisted-by: LLM
---
 arch/x86/Kconfig              | 22 ++++++++++++++++++++++
 arch/x86/Makefile.postlink    | 33 +++++++++++++++++++++++++++++++++
 arch/x86/kernel/vmlinux.lds.S | 20 ++++++++++++++++++++
 3 files changed, 75 insertions(+)
 create mode 100644 arch/x86/Makefile.postlink

diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index 3159852fd..2dfe42c19 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -2082,6 +2082,28 @@ config RANDOMIZE_BASE
 
 	  If unsure, say Y.
 
+config RELOCATABLE_UNCOMPRESSED_KERNEL
+	bool "Build a relocatable uncompressed kernel"
+	depends on RANDOMIZE_BASE && X86_64
+	help
+	  A table of relocation data will be appended to the uncompressed
+	  kernel binary and parsed at boot to do relocation. This lets a
+	  vmlinux entered directly, as through PVH, with no decompressor,
+	  randomize its own virtual base at startup_64.
+
+config RELOCATION_TABLE_SIZE
+	hex "Relocation table size"
+	depends on RELOCATABLE_UNCOMPRESSED_KERNEL
+	range 0x0 0x04000000
+	default "0x00200000"
+	help
+	  This option allows the amount of space reserved for the table to be
+	  adjusted, although the default of 1Mb should be ok in most cases.
+
+	  The build will fail and a valid size suggested if this is too small.
+
+	  If unsure, leave at the default value.
+
 # Relocation on x86 needs some additional build support
 config X86_NEED_RELOCS
 	def_bool y
diff --git a/arch/x86/Makefile.postlink b/arch/x86/Makefile.postlink
new file mode 100644
index 000000000..a6d6ddf8a
--- /dev/null
+++ b/arch/x86/Makefile.postlink
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: GPL-2.0
+# ===========================================================================
+# Post-link x86 pass
+# ===========================================================================
+#
+# 1. Insert relocations into vmlinux
+
+PHONY := __archpost
+__archpost:
+
+-include include/config/auto.conf
+include $(srctree)/scripts/Kbuild.include
+
+CMD_RELOCS = arch/x86/tools/relocs
+quiet_cmd_relocs = RELOCS  $@
+      cmd_relocs = $(CMD_RELOCS) --keep $@
+
+# `@true` prevents complaint when there is nothing to be done
+
+vmlinux.unstripped vmlinux: FORCE
+	@true
+ifeq ($(CONFIG_RELOCATABLE_UNCOMPRESSED_KERNEL),y)
+	$(call if_changed,relocs)
+endif
+
+clean:
+	@true
+
+PHONY += FORCE clean
+
+FORCE:
+
+.PHONY: $(PHONY)
diff --git a/arch/x86/kernel/vmlinux.lds.S b/arch/x86/kernel/vmlinux.lds.S
index 2438b89a4..9c2071c43 100644
--- a/arch/x86/kernel/vmlinux.lds.S
+++ b/arch/x86/kernel/vmlinux.lds.S
@@ -298,6 +298,26 @@ SECTIONS
 	}
 #endif
 
+#ifdef CONFIG_RELOCATABLE_UNCOMPRESSED_KERNEL
+	. = ALIGN(4);
+	.data.reloc : AT(ADDR(.data.reloc) - LOAD_OFFSET) {
+		__relocation_start = .;
+		/*
+		 * Space for relocation table
+		 * This needs to be filled so that the
+		 * relocs tool can overwrite the content.
+		 * An invalid value is left at the start of the
+		 * section to abort relocation if the table
+		 * has not been filled in.
+		 */
+		LONG(0xFFFFFFFF);
+		FILL(0);
+		. += CONFIG_RELOCATION_TABLE_SIZE - 4;
+		__relocation_end = .;
+		__pi___relocation_end = .;
+	}
+#endif
+
 	/*
 	 * struct alt_inst entries. From the header (alternative.h):
 	 * "Alternative instructions for different CPU types or capabilities"
-- 
2.53.0

